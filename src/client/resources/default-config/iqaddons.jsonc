{
    // The version of the config file. Do not change this unless you know what you are doing.
    "rconfig:version": 0,
    // Play a sound when someone joins your party.
    "partyJoinSound": true,
    // Send a alert when you being kicked into the limbo.
    "limboAlert": true,
    // Fix the fishing hook getting stuck when throwing the rod.
    "fixFishingHook": true,
    // Disable the sound played when casting a fishing rod.
    "muteFishingCastSound": true,
    // Disable the annoying Terminator ability cooldown sound/chat message.
    "muteTerminatorCooldownSound": true,
    // Configure commands triggered by party chat messages.
    "partyCommands": {
        // Allow party chat messages to trigger commands.
        "partyCommandsEnabled": true,
        // Run /party warp when someone sends !warp.
        "partyCommandWarp": true,
        // Transfer party leader to the requester.
        "partyCommandTransfer": true,
        // Reply with the requester's ping in party chat.
        "partyCommandPing": true,
        // Toggle /party settings allinvite when requested.
        "partyCommandAllInvite": true,
        // Reply with the current server TPS in party chat.
        "partyCommandTps": true,
        // Promote the requester.
        "partyCommandPromote": true,
        // Kick the specified player from the party.
        "partyCommandKick": true,
        // Start a Kuudra run (Tier 1–5) when requested.
        "partyCommandKuudra": true,
        // Reply with your current chest counter percent.
        "partyCommandChests": true,
        // Reply with your current run counter percent.
        "partyCommandRuns": true,
        // Reply with your current profit counter percent.
        "partyCommandProfit": true
    },
    /*
     * Enable wardrobe slot selection using keybinds.
     * Configure slot keybinds in Options → Controls → Keybinds.
     */
    "wardrobeKeybinds": true,
    // Play a sound after selecting a wardrobe slot via keybind.
    "wardrobeSound": true,
    // Configure shared waypoint creation and rendering.
    "waypointConfig": {
        // Create and render waypoints from Patcher-formatted coordinates.
        "renderWaypoints": true,
        /*
         * How long waypoints stay on screen. Set to 0 to keep them until cleared/expired.
         * Range: 0 - 60
         */
        "waypointsDuration": 7,
        /*
         * Opacity of waypoint renders.
         * Range: 0 - 1
         */
        "waypointOpacity": 0.80625,
        /*
         * Choose how waypoints are displayed.
         * Valid Values: SOLID, OUTLINE, BOTH
         */
        "waypointStyle": "OUTLINE"
    },
    // Show your Kuudra run status on Discord Rich Presence.
    "discordRichPresence": true,
    "Kuudra Utilities": {
        // Display an overlay with timings for each Kuudra phase.
        "customSplits": true,
        // Customize the color of each phase of Custom Splits.
        "splitColorConfig": {
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "title": "AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "supplies": "DARK_AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "build": "DARK_AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "eaten": "DARK_AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "stun": "DARK_AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "dps": "DARK_AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "skip": "DARK_AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "boss": "DARK_AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "overall": "DARK_AQUA",
            // Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
            "pace": "DARK_AQUA"
        },
        // Pace is the run time to beat so just set the best possible times in each phase.
        "customSplitsBenchmarks": {
            /*
             * Preset best-possible Supplies split used in Pace calculation.
             * Range: 0 - 60
             */
            "supplies": 22.5,
            /*
             * Preset best-possible Build split used in Pace calculation.
             * Range: 0 - 60
             */
            "build": 12.0,
            /*
             * Preset best-possible Eaten split used in Pace calculation.
             * Range: 0 - 60
             */
            "eaten": 4.3,
            /*
             * Preset best-possible Stun split used in Pace calculation.
             * Range: 0 - 60
             */
            "stun": 0.0,
            /*
             * Preset best-possible DPS split used in Pace calculation.
             * Range: 0 - 60
             */
            "dps": 3.2,
            /*
             * Preset best-possible Skip split used in Pace calculation.
             * Range: 0 - 60
             */
            "skip": 4.6,
            /*
             * Preset best-possible Boss split used in Pace calculation.
             * Range: 0 - 60
             */
            "boss": 1.7999999999999998
        },
        // Track profit and loss after each Kuudra run and display it on screen.
        "kuudraProfitTracker": true,
        // Customize the color of each line in the Profit Tracker widget.
        "profitTrackerColorConfig": {
            /*
             * Color of the 'Profit Tracker' title text.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "titleColor": "AQUA",
            /*
             * Color of the 'Profit:' label.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "profitLabelColor": "DARK_AQUA",
            /*
             * Color of the 'Runs:' label.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "runsLabelColor": "DARK_AQUA",
            /*
             * Color of the 'Chests:' label.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "chestsLabelColor": "DARK_AQUA",
            /*
             * Color of the 'Rerolls:' label.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "rerollsLabelColor": "DARK_AQUA",
            /*
             * Color of the 'Avg Time:' label.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "avgTimeLabelColor": "DARK_AQUA",
            /*
             * Color of the 'Time:' label.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "timeLabelColor": "DARK_AQUA",
            /*
             * Color of the 'Rate:' label.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "rateLabelColor": "DARK_AQUA",
            /*
             * Color of the 'Tracking:' label.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "trackingLabelColor": "DARK_AQUA"
        },
        // Customize visibility, pricing, faction, and value calculations for the Profit Tracker.
        "profitTrackerConfig": {
            /*
             * Control when the profit tracker is visible.
             * Valid Values: KUUDRA_AREAS, ALWAYS
             */
            "profitTrackerVisibility": "KUUDRA_AREAS",
            /*
             * Choose how Bazaar prices are calculated for profit and chest value.
             * Valid Values: INSTA_SELL, SELL_ORDER
             */
            "bazaarPricingMode": "SELL_ORDER",
            /*
             * Select your Crimson Isle faction to improve profit calculations.
             * Valid Values: BARBARIAN, MAGE
             */
            "crimsonIsleFaction": "MAGE",
            /*
             * Choose how armor value is calculated in the profit tracker.
             * Valid Values: SALVAGE, AUCTION
             */
            "armorValueType": "SALVAGE",
            /*
             * Apply your Kuudra pet level bonus to profit calculations.
             * Range: 0 - 20
             */
            "kuudraPetBonus": 20
        },
        // Track percent toward the 60 chest cap.
        "chestCounterTracker": true,
        // Send reminders to party chat at milestones and when nearing the cap.
        "chestCounterPartyAnnouncements": true,
        // Show the value of each chest when opened.
        "chestValueWidget": true,
        // Highlight already opened chests in Croesus and Vesuvius menus.
        "croesusHelper": true,
        // Automatically start a new Kuudra run after the boss is defeated.
        "autoRequeue": true,
        // Configure Auto Requeue options: delay, auto-stop and run time threshold.
        "autoRequeueConfig": {
            /*
             * Delay before requeueing (in ticks).
             * Range: 1 - 50
             */
            "requeueDelay": 20,
            // Pause Auto Requeue when a completed run hits your configured overall time target.
            "autoStopAutoRequeue": true,
            /*
             * Set the completed run time that will stop Auto Requeue (Current WR: 52s).
             * Range: 1 - 180
             */
            "autoStopAutoRequeueOverallSeconds": 51.0
        },
        // Configure alerts for important Kuudra-related events.
        "kuudraNotifications": {
            // Play a sound when a Kuudra notification is shown.
            "kuudraNotificationsSound": true,
            // Show an alert when Elle asks to build the Ballista.
            "kuudraNotificationBuildStarted": false,
            // Show an alert when Ichor Pool is cast.
            "kuudraNotificationIchorUsed": false,
            // Show an alert for 'No Pre' party messages.
            "kuudraNotificationNoPre": false,
            // Show an alert 4 seconds before the stun phase begins.
            "kuudraNotificationSosReminder": true,
            // Show an alert when the Kuudra phase changes.
            "kuudraPhaseAlert": false,
            // Show an alert when the Ballista is fully built.
            "kuudraNotificationBuildDone": false,
            // Show an alert when supplies reach 6/6.
            "kuudraNotificationSuppliesDone": true,
            // Show an alert when Human Cannonball is purchased.
            "kuudraNotificationCannonball": true,
            // Show an alert if another player is already picking your supply.
            "supplyPickingAlert": true,
            // Show an alert when a supply is dropped.
            "supplyDroppedTitle": true,
            // Show an alert when you place a supply.
            "placedSupplyTitle": true,
            // Show an alert when you finish picking up a supply.
            "supplyPickedUpTitle": false
        },
        // Announce ability usage in party chat.
        "abilityAnnounce": {
            // Send "Spirit Spark Casted!" in party chat.
            "abilityAnnounceSpiritSpark": true,
            // Send "Hollowed Rush Casted!" in party chat.
            "abilityAnnounceHollowedRush": true,
            // Send "Raging Wind Casted!" in party chat.
            "abilityAnnounceRagingWind": true,
            // Send "Ichor Pool Casted!" in party chat.
            "abilityAnnounceIchorPool": true,
            // Send the amount of mana drained to party chat.
            "abilityAnnounceManaDrain": true
        },
        // Track your personal best Kuudra time and notify when beaten.
        "personalBestTracker": true,
        // Track your personal best time for each individual T5 Kuudra phase.
        "phaseSplitsPBTracker": true,
        // Render Etherwarp helper waypoints by Kuudra phase.
        "etherwarpHelper": true,
        // Hide armor stands used for visual effects that don't provide useful information.
        "hideUselessArmorStands": true,
        "hideUselessArmorStandsConfig": {
            // Hide the dropped balista pieces around the build area.
            "build": true,
            // Hide the armour stand from right cannon.
            "rightCannon": true,
            // Hide the armour stand from left cannon.
            "leftCannon": false,
            // Hide the shop armour stand near Triangle.
            "shop": true,
            // Hide other armour stands like bonemerangs, fireballs, etc.
            "others": false
        },
        // Prevent loading nametags from Kuudra mobs.
        "hideMobNametags": true,
        // Hide Kuudra's vanilla boss bar during runs.
        "hideKuudraBossBar": false
    },
    "Phase 1 - Supplies": {
        // Display an overlay that tracks all supply pickup times.
        "supplyTimers": true,
        /*
         * Choose the color used for the Supply Times title.
         * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
         */
        "supplyTimesTitleColor": "AQUA",
        // Show a countdown in Kuudra Splits displaying how long remains until supplies spawn.
        "supplyTimerCountdown": true,
        // Replace the default supply title with a movable widget.
        "supplyProgressDisplay": true,
        /*
         * Alerts you where to go after picking up your first supply. 
         * Priority can be edited in crate_priority.json config.
         */
        "cratePriority": true,
        // Customize title color, duration, animation, and sound for Crate Priority.
        "cratePriorityConfig": {
            /*
             * Choose the text color used by the Crate Priority title widget.
             * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
             */
            "cratePriorityColor": "GOLD",
            /*
             * How long the Crate Priority title stays on screen (seconds).
             * Range: 1 - 10
             */
            "cratePriorityDurationSeconds": 5,
            /*
             * Choose the animation style for the Crate Priority title widget.
             * Valid Values: NONE, FADE, SLIDE
             */
            "cratePriorityAnimation": "FADE",
            // Play a sound when a new Crate Priority action is shown.
            "cratePrioritySound": true
        },
        // Show waypoints at supply locations.
        "supplyWaypoints": true,
        // Customize rendering and helper behavior for Supply Waypoints.
        "supplyWaypointsConfig": {
            // Render a circle in area that you can pull the supply.
            "supplyPullCircle": false,
            /*
             * Change the color of supply waypoints.
             * [Color Format: RGBA]
             */
            "supplyWaypointColor": 1460594175,
            /*
             * Choose if supply hitboxes are outlined, filled, or both.
             * Valid Values: SOLID, OUTLINE, BOTH
             */
            "supplyWaypointStyle": "BOTH",
            /*
             * Adjust the size of supply waypoint boxes.
             * Range: 1 - 3
             */
            "supplyWaypointBoxSize": 1.0,
            // Displays the interaction points where you can pick up the supply.
            "supplyHitBox": false
        },
        // Show pearl throw waypoints during the supply phase.
        "pearlWaypoints": false,
        // Customize rendering, timing, and helper behavior for Pearl Waypoints.
        "pearlWaypointsConfig": {
            /*
             * Color for pearl waypoints. This color is used for all waypoints unless custom colors are set per-waypoint in the JSON config.
             * [Color Format: RGBA]
             */
            "pearlWaypointColor": 1845559295,
            /*
             * Adjusts all JSON waypoint sizes by 10% per step. 
             * 0 = no change (use JSON base sizes).
             * Range: -5 - 5
             */
            "pearlWaypointSize": -4,
            /*
             * Adjust the size of the text displayed on pearl waypoints.
             * Range: 0.01 - 1
             */
            "pearlWaypointsScale": 0.1981,
            /*
             * Adjust the waypoint timer to match your ping, each step changes 1 progress tick. 
             * 0 = 160-200ms with Kuudra's Heart (Tier 3 Talisman)
             * Range: -4 - 4
             */
            "pearlWaypointsTimerDelay": 0,
            /*
             * Choose what pearl waypoints display: timer in milliseconds, timer in seconds, or static text.
             * Valid Values: TIMER_MS, TIMER_SECONDS, TEXT_STATIC
             */
            "pearlWaypointTimes": "TIMER_MS",
            /*
             * Choose how pearl waypoints are rendered: solid, outline, both, or none.
             * Valid Values: SOLID, OUTLINE, BOTH, NONE
             */
            "pearlWaypointRenderStyle": "SOLID",
            // Toggle the outlined block you should stand on when throwing pearls.
            "pearlWaypointBlockOutlines": true,
            // Play a sound and highlight when it's time to throw a pearl.
            "pearlThrowAlert": true,
            // Makes pearl waypoints move up or down based on your position so the marker stays more accurate while doing supplies.
            "dynamicPearlWaypoints": true
        },
        // Show waypoints at crate pile locations.
        "pileWaypoints": true,
        // Customize labels, colors, and file editing for Pile Waypoints.
        "pileWaypointsConfig": {
            // Show or hide pile name labels above waypoints.
            "pileWaypointNames": false,
            /*
             * Change the color of standard supply pile waypoints.
             * [Color Format: RGBA]
             */
            "normalPileColor": 436207615,
            /*
             * Change the color of no-pre supply pile waypoints.
             * [Color Format: RGBA]
             */
            "noPrePileColor": 352386960
        },
        // Send a custom message when recover a supply.
        "supplyRecoverMessage": true,
        // Send a party chat message if you don't have a pre.
        "noPreAlert": true,
        // Announce the position of the second supply in chat.
        "secondSupplyAlert": true,
        // Play a sound and highlight the giant in red when you recover supply inside its hitbox.
        "supplyGiantHitboxAlert": true,
        /*
         * Choose how the giant hitbox highlight is rendered.
         * Valid Values: SOLID, OUTLINE, BOTH
         */
        "supplyGiantHitboxStyle": "OUTLINE"
    },
    "Phase 2 - Build": {
        // Give you some extra luck during the build phase ❤
        "luckyBuild": true,
        // Display an overlay that tracks all freshs during the build.
        "freshTimers": true,
        /*
         * Choose the color used for the Fresh Times title.
         * Valid Values: BLACK, DARK_BLUE, DARK_GREEN, DARK_AQUA, DARK_RED, DARK_PURPLE, GOLD, GRAY, DARK_GRAY, BLUE, GREEN, AQUA, RED, LIGHT_PURPLE, YELLOW, WHITE
         */
        "freshTimesTitleColor": "AQUA",
        // Display a build percent overlay on the screen.
        "buildProgressOverlay": true,
        // Choose the build progress overlay style: 
        "simpleBuildProgressOverlay": true,
        // Show a countdown for when the build starts during the phase animation.
        "buildStartCountdownOverlay": true,
        // Displays a countdown above players who freshed during build.
        "freshCountdown": true,
        // Render some helpful holograms during the build phase
        "buildHelper": true,
        /*
         * Change the opacity of the build helper holograms.
         * Range: 0 - 1
         */
        "buildWaypointsOpacity": 0.5,
        // Hide Kuudra's default pile percent holograms while IQ build overlay is active.
        "hideDefaultBuildPileText": true,
        // Enable this to highlight all teammates from the start of the run.
        "teamHighlight": true,
        /*
         * Change the color of the teammate highlight.
         * [Color Format: RGBA]
         */
        "teamHighlightColor": -645910,
        // Highlight teammates when they fresh for 10 seconds.
        "freshHighlightIndependent": true,
        /*
         * Color to use when highlighting freshers.
         * [Color Format: RGBA]
         */
        "freshHighlightColor": -16713985,
        // Configure the Elle highlight feature.
        "elleHighlightConfig": {
            // Draw a box around Elle during the build phase.
            "elleHighlight": true,
            /*
             * Change the color of the Elle highlight.
             * [Color Format: RGBA]
             */
            "elleHighlightColor": -1409330349,
            /*
             * Change the style of the Elle highlight.
             * Valid Values: SOLID, OUTLINE, BOTH
             */
            "elleHighlightStyle": "BOTH"
        },
        // Send a party message when you fresh.
        "freshMessage": true,
        // Disable most of sounds during build for a cleaner audio experience.
        "cleanBallistaBuildSounds": false,
        // Replace the default ballista build sound while in build phase.
        "replaceBallistaBuildSound": false
    },
    "Phase 3 - Stun": {
        // Prevent buying perks that provide no benefit for your run.
        "blockUselessPerks": true,
        // Show Kuudra's real health inside the Magma Cube.
        "kuudraHealth": true,
        // Customize the colors used for each Kuudra health range.
        "kuudraHealthColorConfig": {
            // [Color Format: RGBA]
            "high": -11141291,
            // [Color Format: RGBA]
            "mid": -171,
            // [Color Format: RGBA]
            "low": -22016,
            // [Color Format: RGBA]
            "critical": -43691
        },
        // Show HP and percentage in the health widget.
        "kuudraHealthDisplay": true,
        // Configure Kuudra's hitbox overlay during the run.
        "kuudraHitbox": {
            // Show Kuudra's hitbox overlay.
            "kuudraHitbox": true,
            /*
             * Change the hitbox color for better visibility.
             * [Color Format: RGBA]
             */
            "kuudraHitboxColor": -100469252,
            /*
             * Choose how the hitbox is drawn (outline, filled, or both).
             * Valid Values: SOLID, OUTLINE, BOTH
             */
            "kuudraHitboxStyle": "OUTLINE"
        },
        // Show waypoints for stun positions.
        "stunWaypoints": false,
        /*
         * Change the color of stun waypoints.
         * [Color Format: RGBA]
         */
        "stunWaypointColor": -939461121,
        /*
         * Choose how stun waypoints are drawn (outline, filled, or both).
         * Valid Values: SOLID, OUTLINE, BOTH
         */
        "stunWaypointStyle": "OUTLINE",
        /*
         * Choose which stun location marker to display.
         * Valid Values: RIGHT_POD, LEFT_POD, BACK_POD
         */
        "stunWaypointBlock": "LEFT_POD"
    },
    "Phase 4 - Boss Fight": {
        // Hide Kuudra's default damage title (e.g. ☠ 240M/240M❤).
        "hideDamageTitle": true,
        // Show an alert indicating which side Kuudra will spawn on.
        "kuudraDirectionAlert": false,
        // Show an alert when any teammate deals Rend damage.
        "rendDamageAlert": true,
        // Track Bonemerang backbone timing with a HUD percent bar and Rend alert.
        "backboneAlert": true,
        // Play a sound when the Backbone Alert is active.
        "backboneAlertSound": true,
        /*
         * Trigger the Backbone Rend earlier by this many ticks.
         * Range: 0 - 6
         */
        "backboneAdvanceTicks": 2,
        // Show an alert when you enter a tentacle's danger zone.
        "dangerZoneAlert": false,
        // Render the area of effect of the ichor pools on the ground.
        "ichorPoolArea": true,
        // Show your distance from Kuudra inside the Magma Cube.
        "kuudraDistanceDisplay": false
    }
}